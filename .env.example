# Copy this file to .env.local and fill it in. .env.local is excluded from git.

# ---------------------------------------------------------------- database
# From your Supabase project: click Connect at the top of the dashboard.
#   DATABASE_URL   the "Transaction pooler" string, port 6543. Used at runtime.
#   DIRECT_URL     the "Session pooler" string,     port 5432. Used for migrations.
# Replace [YOUR-PASSWORD] entirely, brackets included.
# Delete ?pgbouncer=true if it is there. It is a Prisma flag; postgres.js rejects it.
# Do NOT use the "Direct connection" string: it is IPv6 only and will time out.
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------- providers
# Groq: https://console.groq.com/keys       serves the orchestrator and Computation
# Gemini: https://aistudio.google.com/apikey serves Tutor and Management
# Neither requires a card. The app still works with neither, using deterministic
# routing and phrasing, and every figure is identical either way.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter: https://openrouter.ai/keys        serves the Management agent
# Optional. Without it, Management runs on Gemini and nothing breaks.
# It has no default model, because OpenRouter's free catalogue changes weekly.
# Run `npm run providers` to list the free models that support tool calling,
# then set OPENROUTER_MODEL below. Both are needed for OpenRouter to be used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional model overrides. Run `npm run providers` to see what your keys reach.
# Providers retire models: Groq retired the Llama chat models in June 2026.
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=

# Optional. The embedding model used for concept retrieval.
# Leave unset unless `npm run corpus:embed` reports that the default is gone.
# EMBEDDING_MODEL=gemini-embedding-001

# Which provider serves which agent. Optional.
# Run `npm run bench` to measure your own latency, then override if needed.
# Comma-separated, first is preferred. Anything omitted still follows as a fallback.
# AGENT_TUTOR_PROVIDER=groq
# AGENT_COMPUTATION_PROVIDER=groq
# AGENT_MANAGEMENT_PROVIDER=openrouter

# How long any single model call may take before it is abandoned and the
# deterministic path answers instead. Default 12000.
# MODEL_TIMEOUT_MS=12000

# How long a user's question may take to embed before retrieval falls back to
# term matching. Corpus embedding is unaffected. Default 1500.
# EMBED_TIMEOUT_MS=1500
